{
  "info": {
    "name": "ManKu API",
    "_postman_id": "manku-api-collection",
    "description": "Koleksi API ManKu — Auth & Transaction\n\nCARA PAKAI:\n1. Import file ini ke Postman\n2. Import juga file ManKu_ENV.postman_environment.json\n3. Pilih environment 'ManKu Local' di pojok kanan atas\n4. Jalankan '01 Login' terlebih dahulu — token akan tersimpan otomatis\n5. Semua request lain sudah otomatis pakai token tersebut",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "🔐 AUTH",
      "item": [
        {
          "name": "01 Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register/", "host": ["{{base_url}}"], "path": ["api","auth","register",""] },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"first_name\": \"Fandi\",\n    \"email\": \"fandi@example.com\",\n    \"password\": \"Password123!\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "02 Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/verify-otp/", "host": ["{{base_url}}"], "path": ["api","auth","verify-otp",""] },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"fandi@example.com\",\n    \"code\": \"123456\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "03 Login ✅ (auto-save token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.tokens) {",
                  "    pm.environment.set('access_token',  json.tokens.access);",
                  "    pm.environment.set('refresh_token', json.tokens.refresh);",
                  "    pm.environment.set('user_id',       json.user.id);",
                  "    console.log('✅ Token tersimpan untuk user:', json.user.name);",
                  "} else {",
                  "    console.error('❌ Login gagal:', json.message);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api","auth","login",""] },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"fandimugiwara93@gmail.com\",\n    \"password\": \"Password123!\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "04 Google Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/google-login/", "host": ["{{base_url}}"], "path": ["api","auth","google-login",""] },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id_token\": \"PASTE_TOKEN_DARI_HALAMAN_TEST_DISINI\"\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "📂 CATEGORY",
      "item": [
        {
          "name": "01 List Kategori",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/categories/", "host": ["{{base_url}}"], "path": ["api","categories",""] }
          },
          "response": []
